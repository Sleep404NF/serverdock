{
  "info": {
    "name": "ServerDock",
    "description": "ServerDock 백엔드 API. 로그인하면 토큰이, 서버를 만들면 serverId가 컬렉션 변수에 자동 저장된다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "serverId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"myadmin01\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "첫 가입자는 ADMIN이 된다."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"myadmin01\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "성공하면 accessToken을 {{token}}에 저장한다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('token', pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Servers",
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/servers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"야생 서버\",\n  \"gameVersion\": \"1.21.4\",\n  \"loader\": \"FABRIC\",\n  \"memoryMb\": 4096\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "관리자만 가능. port를 비우면 25565부터 자동 할당. 성공하면 id를 {{serverId}}에 저장한다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('serverId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/servers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servers"
              ]
            }
          }
        },
        {
          "name": "Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/servers/{{serverId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servers",
                "{{serverId}}"
              ]
            }
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/servers/{{serverId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servers",
                "{{serverId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"바뀐 이름\",\n  \"memoryMb\": 6144,\n  \"autoRestart\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "OWNER만 가능. 보낸 필드만 바뀐다."
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/servers/{{serverId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servers",
                "{{serverId}}"
              ]
            },
            "description": "OWNER만 가능."
          }
        }
      ]
    }
  ]
}
