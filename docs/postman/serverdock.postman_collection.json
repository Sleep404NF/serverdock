{
  "info": {
    "name": "ServerDock",
    "description": "ServerDock 백엔드 API. 로그인하면 토큰이, 서버를 만들면 serverId가 컬렉션 변수에 자동 저장된다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "serverId",
      "value": ""
    },
    {
      "key": "inviteId",
      "value": ""
    },
    {
      "key": "inviteCode",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"friend01\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "가입자는 항상 USER. 아이디 6~20자(영문, 숫자, _), 비밀번호 8~72자."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "개발용 관리자는 admin / admin (서버 시작 시 자동 생성). 성공하면 accessToken을 {{token}}에 저장한다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('token', pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Servers",
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/servers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"야생 서버\",\n  \"gameVersion\": \"1.21.4\",\n  \"loader\": \"FABRIC\",\n  \"memoryMb\": 4096\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "관리자만 가능. port를 비우면 25565부터 자동 할당. 성공하면 id를 {{serverId}}에 저장한다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('serverId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/servers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servers"
              ]
            }
          }
        },
        {
          "name": "Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/servers/{{serverId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servers",
                "{{serverId}}"
              ]
            }
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/servers/{{serverId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servers",
                "{{serverId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"바뀐 이름\",\n  \"memoryMb\": 6144,\n  \"autoRestart\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "OWNER만 가능. 보낸 필드만 바뀐다."
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/servers/{{serverId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servers",
                "{{serverId}}"
              ]
            },
            "description": "OWNER만 가능."
          }
        }
      ]
    },
    {
      "name": "Invites",
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/servers/{{serverId}}/invites",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servers",
                "{{serverId}}",
                "invites"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"MEMBER\",\n  \"expiresIn\": \"ONE_DAY\",\n  \"maxUses\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "ADMIN 이상. role: ADMIN | MEMBER (ADMIN 초대는 OWNER만). expiresIn: THIRTY_MINUTES | ONE_HOUR | SIX_HOURS | TWELVE_HOURS | ONE_DAY | SEVEN_DAYS (비우면 ONE_DAY). maxUses: 1~100 (비우면 무제한). 성공하면 {{inviteId}}, {{inviteCode}}에 저장."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('inviteId', body.id);",
                  "    pm.collectionVariables.set('inviteCode', body.code);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/servers/{{serverId}}/invites",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servers",
                "{{serverId}}",
                "invites"
              ]
            },
            "description": "ADMIN 이상. 최근에 만든 것부터."
          }
        },
        {
          "name": "Revoke",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/servers/{{serverId}}/invites/{{inviteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servers",
                "{{serverId}}",
                "invites",
                "{{inviteId}}"
              ]
            },
            "description": "ADMIN 이상."
          }
        },
        {
          "name": "Accept",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invites/{{inviteCode}}/accept",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "invites",
                "{{inviteCode}}",
                "accept"
              ]
            },
            "description": "로그인한 누구나. 다른 계정으로 Login한 뒤 보내야 한다. 만료/횟수 소진 410, 이미 멤버 409."
          }
        }
      ]
    }
  ]
}
