# 이 파일을 .env로 복사해서 값을 채운다. .env는 git에 올라가지 않는다.
# 디스코드 개발자 포털(https://discord.com/developers/applications)에서 앱을 만들고 값을 가져온다.

# Bot 탭 → Reset Token
DISCORD_BOT_TOKEN=
# OAuth2 탭 → Client ID, Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# OAuth2 탭 → Redirects에도 똑같이 등록한다 (기본값을 쓰면 비워 둬도 된다)
# DISCORD_REDIRECT_URI=http://localhost:5173/api/discord/callback
